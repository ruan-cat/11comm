{
	"name": "@01s-11comm/root",
	"private": true,
	"version": "1.2.1",
	"author": {
		"name": "ruan-cat",
		"email": "1219043956@qq.com",
		"url": "https://github.com/ruan-cat"
	},
	"license": "ISC",
	"description": "01s-11comm智慧社区 monorepo根目录",
	"main": "index.js",
	"type": "module",
	"packageManager": "pnpm@11.0.8",
	"engines": {
		"node": ">=22.14.0"
	},
	"scripts": {
		"build": "turbo build",
		"release:bumpp": "bumpp --push",
		"release:changelogen": "changelogen --bump --release --push",
		"release": "pnpm run release:sub && pnpm run release:root && pnpm run git:push",
		"release:sub": "relizy-runner release --no-publish --no-provider-release --no-push --yes",
		"release:root": "bumpp --no-push --yes --release patch",
		"release:dry": "relizy-runner release --dry-run --no-publish --no-provider-release --no-push --no-commit --no-clean --yes",
		"changelog": "relizy-runner changelog",
		"changelog:dry": "relizy-runner changelog --dry-run",
		"changelog:root": "changelogen --output CHANGELOG.md",
		"up-taze": "pnpm -w up @ruan-cat/taze-config -L && npx taze -r",
		"git:dev-2-main": "git rebase dev main && pnpm run git:push",
		"git:main-2-dev": "git rebase main dev",
		"build:docs": "turbo build:docs",
		"test": "vitest --ui --watch --api.port=4000",
		"format": "prettier --experimental-cli --write '**/*.{js,jsx,ts,tsx,mts,json,css,scss,md,yml,yaml,html}'",
		"format:changelog": "pnpm exec prettier --experimental-cli --write CHANGELOG.md \"apps/*/CHANGELOG.md\"",
		"deploy:turbo": "turbo deploy",
		"deploy": "dotenvx run -f apps/admin/.env.production -f .env -- vdt deploy",
		"not-use-in-cloudflare-worker-preinstall": "npm run corepack:pnpm && npx only-allow pnpm",
		"corepack:pnpm": "corepack enable && corepack install",
		"clear": "pnpm run clear:deps && pnpm run clear:cache",
		"clear:deps": "rimraf -g '**/{node_modules,package-lock.json,pnpm-lock.yaml}'",
		"clear:cache": "rimraf -g '**/{dist,.turbo,.vercel,.output,.cache,.temp}'",
		"git:push": "git push --follow-tags",
		"git:fetch": "git fetch -p",
		"build:cloudflare:admin": "pnpm -F=@01s-11comm/admin build:prod:cloudflare",
		"build:cloudflare:docs": "pnpm -F=@01s-11comm/admin docs:build",
		"build:vercel:admin": "pnpm -F=@01s-11comm/admin build:prod:vercel",
		"build:vercel:app": "pnpm -F=@01s-11comm/app build:h5:prod",
		"format:*": "prettier --experimental-cli --write . --ignore-path ./.config/.prettierignore --ignore-path .gitignore",
		"ci": "pnpm run build",
		"repro:relizy-path": "node docs/issues/relizy/repro-relizy-body-path-includes.mjs",
		"prepare": "simple-git-hooks"
	},
	"devDependencies": {
		"@antfu/eslint-config": "^5.4.1",
		"@changesets/cli": "^2.31.0",
		"@dotenvx/dotenvx": "^1.65.0",
		"@plus-pro-components/resolver": "^0.0.3",
		"@prettier/plugin-oxc": "^0.1.4",
		"@ruan-cat/claude-notifier": "^0.11.0",
		"@ruan-cat/commitlint-config": "^4.11.1",
		"@ruan-cat/domains": "^2.5.0",
		"@ruan-cat/generate-code-workspace": "^0.8.1",
		"@ruan-cat/taze-config": "^1.1.1",
		"@ruan-cat/utils": "^4.25.1",
		"@ruan-cat/vercel-deploy-tool": "^2.0.0",
		"@shixinde/apifox-swagger": "^4.3.1",
		"@svitejs/changesets-changelog-github-compact": "^1.2.0",
		"@types/eslint-config-prettier": "^6.11.3",
		"@types/js-yaml": "^4.0.9",
		"@types/lodash-es": "^4.17.12",
		"@types/node": "^24.12.3",
		"@vitest/ui": "^3.2.4",
		"@vue/compiler-sfc": "^3.5.34",
		"bumpp": "^10.4.1",
		"changelogen": "^0.6.2",
		"changelogithub": "^13.16.1",
		"commander": "^14.0.3",
		"commitizen": "^4.3.1",
		"commitlint": "^20.5.3",
		"consola": "^3.4.2",
		"cross-env": "^10.1.0",
		"cz-git": "^1.13.0",
		"eslint": "^9.39.4",
		"eslint-config-prettier": "^10.1.8",
		"eslint-config-turbo": "^2.9.10",
		"eslint-plugin-prettier": "^5.5.5",
		"js-yaml": "^4.1.1",
		"lint-staged": "^16.4.0",
		"lodash-es": "^4.18.1",
		"nitro": "3.0.1-alpha.2",
		"only-allow": "^1.2.2",
		"pkg-types": "^2.3.1",
		"pnpm-workspace-yaml": "^1.6.0",
		"prettier": "^3.8.3",
		"prettier-plugin-lint-md": "^1.0.1",
		"relizy": "1.2.2-beta.0",
		"rimraf": "^6.1.3",
		"shx": "^0.4.0",
		"simple-git-hooks": "^2.13.1",
		"taze": "^19.11.0",
		"tsx": "^4.21.0",
		"turbo": "^2.9.10",
		"typescript": "^5.9.3",
		"vercel": "^46.1.1",
		"vite": "7.1.12",
		"vitest": "^3.2.4",
		"vue": "^3.5.34",
		"vue-tsc": "^3.2.8",
		"vuepress": "2.0.0-rc.18"
	},
	"dependencies": {
		"@01s-11comm/admin": "workspace:^",
		"@01s-11comm/app": "workspace:^",
		"@01s-11comm/api": "workspace:^",
		"@01s-11comm/type": "workspace:^"
	}
}

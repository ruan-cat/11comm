# 变量必须以 VITE_ 为前缀才能暴露给外部读取
NODE_ENV = 'production'
# 是否去除console 和 debugger
VITE_DELETE_CONSOLE = true
# 是否开启sourcemap
VITE_SHOW_SOURCEMAP = false

# 清空基础 env 中继承的地址，强制生产环境走 @ruan-cat/domains 的 11commAppNitroServer 别名解析
VITE_SERVER_BASEURL = 'https://01s-11-server.ruan-cat.com'
VITE_UPLOAD_BASEURL = 'https://01s-11-server.ruan-cat.com/upload'
VITE_API_SECONDARY_URL = ''
VITE_WX_APPID = 'wxe5ca920dacf8906f'
# 当前接口运行时
VITE_API_RUNTIME = 'nitro-standalone'
# 生产 Nitro 微信登录返回 accessToken/refreshToken 双 token。
VITE_AUTH_MODE = 'double'
# H5 生产环境直接请求 Nitro 生产域名，不走本地代理
VITE_APP_PROXY_ENABLE = false

# Phase6 apps/api shadow cutover defaults to legacy runtime unless enabled explicitly.
VITE_11COMM_API_BASE_URL = 'https://01s-11-server.ruan-cat.com'
VITE_11COMM_API_SHADOW_ENABLE = true

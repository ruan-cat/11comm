{
	"$schema": "https://turbo.build/schema.json",
	"extends": ["//"],
	"tasks": {
		"build:h5:prod": {
			"cache": true,
			"outputs": ["dist/**"]
		},
		"build:nitro": {
			"cache": true,
			"outputs": [".output/**"]
		},
		"build:nitro:node": {
			"cache": true,
			"outputs": [".output/**"]
		},
		"build:nitro:vercel": {
			"cache": true,
			"outputs": [".output/**", ".vercel/output/**"],
			"dependsOn": ["build:h5:prod"]
		},
		"docs:build": {
			"cache": true,
			"outputs": ["docs/.vitepress/dist/**"]
		}
	}
}

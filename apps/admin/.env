# Vercel Neon 集成环境变量前缀
# 该前缀用于标识从 Vercel 拉取的 Neon 数据库环境变量
# 在 Vercel Neon 集成配置页面设置和维护：
# https://vercel.com/ruancat-projects/~/integrations/neon/icfg_aFCpQJZiS9sXcBJfKSgHG3ZR/resources/storage/store_1hsWrjTtdSHtwdJQ/projects
# 拉取后的环境变量格式示例：comm_admin_11__DATABASE_URL="xxx"
VERCEL_ENV_PREFIX=comm_admin_11_

# Neon 数据库连接字符串
# 从 Vercel 项目设置 -> Environment Variables 中获取
# 或从 Neon Dashboard -> Connection Details 中复制
# DATABASE_URL=postgresql://username:password@host.neon.tech/database?sslmode=require

# 平台本地运行端口号
VITE_PORT = 8080

# 是否隐藏首页 隐藏 true 不隐藏 false （勿删除，VITE_HIDE_HOME只需在.env文件配置）
VITE_HIDE_HOME = false

# 是否需要反向代理？
VITE_IS_REVERSE_PROXY = "false"
# 现在开始对接真实的生产环境接口 故需要反向代理
# VITE_IS_REVERSE_PROXY = "true"

# 开发接口地址
VITE_BASE_URL = "https://m1.apifoxmock.com/m1/6386631-6083270-default"
# 现在开始对接真实的生产环境接口
# VITE_BASE_URL = "http://47.93.160.11:10001"

# 代理前缀 应该和服务器的 nginx 配置相一致
# VITE_PROXY_PREFIX = "/dev-api"
# VITE_PROXY_PREFIX = "/prod-api"

# https://developers.cloudflare.com/workers/ci-cd/builds/build-image/
# 将包锁文件上传 即可更改构建流为 pnpm 了 该环境变量失效
# SKIP_DEPENDENCY_INSTALL = 1

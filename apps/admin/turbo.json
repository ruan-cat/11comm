{
	"extends": ["//"],
	"tasks": {
		"rm:types": {
			"cache": false
		},
		"vite:dev": {
			"cache": false,
			"persistent": true,
			"dependsOn": ["rm:types"]
		},
		"vite:build:staging": {
			"cache": true,
			"outputs": ["dist/**"]
		},
		"vite:build:prod": {
			"cache": true,
			"outputs": ["dist/**"]
		},
		"vite:build:prod:cloudflare": {
			"cache": true,
			"outputs": [".output/**"]
		},
		"vite:build:prod:vercel": {
			"cache": true,
			"env": ["ENABLE_EXPERIMENTAL_COREPACK", "R2_*", "comm_admin_11__*"],
			"outputs": [".vercel/output/**"]
		},
		"move-vercel-output-to-root": {
			"cache": false,
			"dependsOn": ["vite:build:prod:vercel"]
		},
		"typedoc": {
			"cache": false
		},
		"do-docs-dev": {
			"cache": false,
			"persistent": true
		},
		"do-docs-build": {
			"cache": true
		}
	}
}

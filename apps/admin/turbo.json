{
	"extends": ["//"],
	"tasks": {
		"env:pull": {
			"cache": false
		},
		"rm:types": {
			"cache": false
		},
		"vite:dev": {
			"cache": false,
			"persistent": true,
			"dependsOn": ["rm:types"]
		},
		"vite:build:staging": {
			"cache": true,
			"outputs": ["dist/**"]
		},
		"vite:build:prod": {
			"cache": true,
			"outputs": ["dist/**"]
		},
		"vite:build:prod:cloudflare": {
			"cache": true,
			"outputs": [".output/**"],
			"dependsOn": ["env:pull"]
		},
		"typedoc": {
			"cache": false
		},
		"do-docs-dev": {
			"cache": false,
			"persistent": true
		},
		"do-docs-build": {
			"cache": true
		}
	}
}

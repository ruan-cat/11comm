{
	"name": "@01s-11comm/type",
	"description": "业务类型库，用于存放项目中共享的业务类型定义。",
	"version": "1.1.4",
	"private": false,
	"type": "module",
	"packageManager": "pnpm@10.32.1",
	"engines": {
		"node": ">=22.14.0"
	},
	"main": "./src/index.ts",
	"types": "./src/index.ts",
	"exports": {
		".": {
			"import": "./src/index.ts",
			"require": "./src/index.ts",
			"types": "./src/index.ts"
		},
		"./business": "./src/business/index.ts",
		"./common": "./src/common/index.ts",
		"./*": "./src/*.ts"
	},
	"scripts": {
		"typecheck": "tsc --noEmit"
	},
	"keywords": [
		"types",
		"typescript",
		"business-types"
	],
	"license": "MIT",
	"dependencies": {
		"@ruan-cat/utils": "^4.22.0",
		"drizzle-orm": "^0.42.0",
		"drizzle-zod": "^0.8.3",
		"zod": "^3.25.76"
	},
	"devDependencies": {
		"typescript": "^5.9.3"
	}
}

{
	"name": "@01s-11comm/type",
	"description": "业务类型库，用于存放项目中共享的业务类型定义。",
	"version": "1.0.0",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@10.25.0",
	"engines": {
		"node": ">=22.14.0"
	},
	"main": "./src/index.ts",
	"types": "./src/index.ts",
	"exports": {
		".": {
			"types": "./src/index.ts",
			"import": "./src/index.ts"
		}
	},
	"scripts": {
		"typecheck": "tsc --noEmit"
	},
	"keywords": [
		"types",
		"typescript",
		"business-types"
	],
	"license": "MIT",
	"dependencies": {
		"@ruan-cat/utils": "4.16.0"
	},
	"devDependencies": {
		"typescript": "^5.9.3"
	}
}
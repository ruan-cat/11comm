{
	"permissions": {
		"allow": [
			"WebFetch(domain:01s-11.apifox.cn)",
			"WebFetch(domain:01s-11.apifox.cn)",
			"WebFetch(domain:01s-11.apifox.cn)",
			"WebFetch(domain:01s-11.apifox.cn)",
			"mcp__ide__getDiagnostics",
			"WebFetch(domain:github.com)",
			"WebFetch(domain:utils.ruan-cat.com)",
			"WebFetch(domain:utils.ruan-cat.com)",
			"mcp__fetch-mcp__fetch_markdown"
		],
		"deny": [],
		"additionalDirectories": [
			"F:\\store\\PixPin"
		]
	},
	"hooks": {
		"Stop": [
			{
				"matcher": "os == 'windows'",
				"hooks": [
					{
						"type": "command",
						"command": "npx @ruan-cat/claude-notifier@latest task-complete --message \"Claude Code 任务已完成\""
					}
				]
			}
		],
		"SessionStart": [
			{
				"matcher": "os == 'windows'",
				"hooks": [
					{
						"type": "command",
						"command": "npx @ruan-cat/claude-notifier@latest long-task --task-description \"Claude 会话\" &"
					}
				]
			}
		],
		"SessionEnd": [
			{
				"matcher": "os == 'windows'",
				"hooks": [
					{
						"type": "command",
						"command": "npx @ruan-cat/claude-notifier@latest long-task --stop"
					}
				]
			}
		]
	}
}
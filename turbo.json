{
	"$schema": "https://turbo.build/schema.json",
	"tasks": {
		"build": {
			"cache": true,
			"outputs": ["**/dist/**", "**/.output/**"],
			"dependsOn": ["^build"]
		},
		"docs:build": {
			"cache": true,
			"outputs": ["**/.vitepress/dist/**", "**/.vuepress/dist/**"],
			"dependsOn": ["^build"]
		},
		"//#deploy": {
			"cache": false,
			"dependsOn": ["^build", "^docs:build"]
		}
	}
}
